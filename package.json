{
  "name": "stumpcast",
  "private": true,
  "version": "1.3.4",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron-winstaller"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present --filter @stumpcast/server --filter @stumpcast/admin --filter @stumpcast/overlay run dev",
    "dev:desktop": "pnpm --filter @stumpcast/desktop dev",
    "build": "pnpm -r --if-present run build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "fixtures:check": "node scripts/fixtures-check.mjs",
    "selectors:sign": "node scripts/sign-selectors.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
