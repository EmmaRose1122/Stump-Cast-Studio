{
  "name": "@stumpcast/server",
  "version": "1.3.5",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "dependencies": {
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@stumpcast/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "obs-websocket-js": "^5.0.8",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --external:fastify --external:@fastify/* --external:better-sqlite3 --external:drizzle-orm --external:pino --external:sharp --external:zod --external:obs-websocket-js --external:ws --outfile=dist/index.mjs"
  }
}
