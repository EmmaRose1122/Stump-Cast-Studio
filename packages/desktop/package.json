{
  "name": "@stumpcast/desktop",
  "version": "1.3.7",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "pnpm --filter @stumpcast/server build && tsc -p tsconfig.json && esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs",
    "dev": "pnpm build && electron .",
    "stage": "node scripts/stage.mjs",
    "package": "pnpm build && node scripts/stage.mjs --pack",
    "package:dir": "pnpm build && node scripts/stage.mjs --pack --dir"
  },
  "dependencies": {
    "@stumpcast/server": "workspace:*",
    "@stumpcast/shared": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
